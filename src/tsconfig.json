{
  "extends": "./tsconfig-base.json",
  "compilerOptions": {
    "outDir": "../dist",
    "declarationDir": "../dist/types",
    "types": ["node"],
    "lib": [
      "es2020",
      "dom"
    ],
    "sourceRoot":"./src",
    "composite": true
  },
  "include": [
    "./*.ts",
    "core/**/*.ts",
    "ui/**/*.ts",
    "node/**/*.ts",
    "test/**/*.ts"
  ]
}
