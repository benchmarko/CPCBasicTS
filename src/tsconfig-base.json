{
  "compilerOptions": {
      "module": "es2020",
      "pretty": true,
      "target": "es6",
      "moduleResolution": "bundler",

      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "composite": true,
      "noEmitOnError": true,

      "strictNullChecks": true,
      "noImplicitAny": true,
      "noImplicitThis": true,
      "strictPropertyInitialization": true,
      "strictFunctionTypes": true,
      "noUnusedLocals": true,
      "noUnusedParameters": true,

      "skipLibCheck": true,

      "alwaysStrict": true,
      "preserveConstEnums": true,
      "newLine": "lf",

      "types": []
  }
}