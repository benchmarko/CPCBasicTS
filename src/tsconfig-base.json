{
  "compilerOptions": {
      "module": "es2020",
      "pretty": true,
      "target": "es2020",
      "moduleResolution": "bundler",
      "strict": true,

      "declaration": true,
      "declarationMap": true,
      "sourceMap": true,
      "composite": true,
      "noEmitOnError": true,

      "noUnusedLocals": true,
      "noUnusedParameters": true,

      "skipLibCheck": true,

      "preserveConstEnums": true,
      "newLine": "lf",

      "types": []
  }
}